        {
          "id": "8f81fd22-2679-4563-b9be-70d208ae8851",
          "name": "Extract Document",
          "request": {
            "name": "Extract Document",
            "description": {
              "content": "Extract structured data from document(s).\n\nReturns a clean `fields` dict with extracted key-value data, plus any `tables` found.\nAdd `detail=true` for the full AI output (entities, summary, primary/secondary entities).\nAdd `chunk_size` to get overlapping text chunks from the raw OCR.\n\n- Single file <=5 pages: synchronous (200)\n- Multiple files or >5 pages: async job (202), poll via /v1/jobs/{id}",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "extract"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "(Required) Document file(s) to extract"
                },
                {
                  "key": "model",
                  "value": "qomplement-OCR-v1",
                  "type": "text",
                  "description": "OCR model: qomplement-OCR-v1 (standard) or qomplement-OCR-XL-v1 (high precision)"
                },
                {
                  "key": "schema",
                  "value": "<string>",
                  "type": "text",
                  "description": "JSON schema of target fields"
                },
                {
                  "key": "output_format",
                  "value": "json",
                  "type": "text",
                  "description": "Output format: json, csv, xml"
                },
                {
                  "key": "detail",
                  "value": "false",
                  "type": "text",
                  "description": "Include full AI extraction detail (entities, summary, primary/secondary entities)"
                },
                {
                  "key": "chunk_size",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Split OCR text into chunks of this many characters"
                },
                {
                  "key": "chunk_overlap",
                  "value": "0",
                  "type": "text",
                  "description": "Number of overlapping characters between chunks"
                },
                {
                  "key": "webhook_url",
                  "value": "<string>",
                  "type": "text",
                  "description": "Webhook URL for async results"
                }
              ]
            }
