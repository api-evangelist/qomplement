{
  "opencollection": "1.0.0",
  "info": {
    "name": "StructDatafy API Keys API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Api Keys",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/keys"
          },
          "docs": "List all API keys."
        },
        {
          "info": {
            "name": "Create Api Key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API key. The full key is shown only once."
        },
        {
          "info": {
            "name": "Revoke Api Key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/keys/:key_id",
            "params": [
              {
                "name": "key_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Revoke an API key."
        }
      ]
    }
  ],
  "bundled": true
}