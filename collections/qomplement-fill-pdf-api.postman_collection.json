          "request": {
            "name": "Fill Pdf",
            "description": {
              "content": "Fill a PDF form using source documents, natural language instructions, or explicit mappings.\n\nThree ways to fill:\n1. **Source documents** — upload source doc(s), AI extracts and maps data to form fields\n2. **Instructions** — describe what to fill in plain language\n3. **Explicit mappings** — provide JSON {field_name: value} pairs\n\nAt least one of source_files, instructions, or field_mappings must be provided.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "fill",
                "pdf"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
